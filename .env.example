# Supabase — copia este archivo a .env y rellena los valores
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_o_anon_key

# Resend (envío de emails) — secreto de servidor, NO usar prefijo VITE_.
# Se consume desde Edge Functions de Supabase (no desde el frontend).
RESEND_API_KEY=re_xxx
