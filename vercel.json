{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/app/version", "destination": "/api/og" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/facturacion", "schedule": "0 3 * * *" },
    { "path": "/api/facturacion?action=cierre-mes", "schedule": "0 4 * * *" }
  ]
}
